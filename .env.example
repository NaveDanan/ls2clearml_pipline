# Label Studio Configuration
LABEL_STUDIO_HOST=http://localhost:8080
LABEL_STUDIO_API_KEY=your_label_studio_api_key_here

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=labelstudio
POSTGRES_USER=labelstudio
POSTGRES_PASSWORD=your_secure_password_here

# Webhook Server Configuration
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_SECRET=your_webhook_secret_here

# ClearML Configuration
CLEARML_API_HOST=https://api.clear.ml
CLEARML_WEB_HOST=https://app.clear.ml
CLEARML_FILES_HOST=https://files.clear.ml
CLEARML_API_ACCESS_KEY=your_clearml_access_key
CLEARML_API_SECRET_KEY=your_clearml_secret_key

# Dataset Configuration
CLEARML_PROJECT_NAME=ImageAnnotation
CLEARML_DATASET_NAME=AnnotatedImages
